CONFIG_BT=n
CONFIG_ZMK_BLE=n
# Disable conflicting power hardware features
CONFIG_ZMK_EXT_POWER=n
CONFIG_ZMK_BATTERY_STATUS=n

# Fix bad clone crystal issues (Use Internal RC Oscillator)
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

# Disable DCDC converters (Use standard LDO)
CONFIG_BOARD_ENABLE_DCDC=n
CONFIG_BOARD_ENABLE_DCDC_HV=n
